generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ScheduledMessage {
  id        String    @id @default(uuid())
  userId    String
  chatId    String
  content   String
  sendAt    DateTime
  status    String    @default("pending")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, sendAt])
}
